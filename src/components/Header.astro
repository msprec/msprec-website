---
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const normalizedPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
const links = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/quality', label: 'Quality' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-50 border-b border-navy-950/10 bg-white/95 text-navy-950 shadow-[0_8px_30px_rgba(4,21,47,.08)] backdrop-blur-xl">
  <div class="container-wide flex h-20 items-center justify-between gap-6 lg:h-25">
    <a href="/" class="focus-ring flex items-center gap-3" aria-label="Maisi Precision home">
      <img src="/maisi-logo.png" alt="Maisi Precision" width="80" height="80" class="h-14 w-14 object-contain lg:h-20 lg:w-20" />
      <strong class="text-[1.05rem] font-extrabold tracking-[.09em]">MAISI PRECISION</strong>
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={normalizedPath === link.href ? 'page' : undefined} class:list={["focus-ring border-b-2 py-2 text-sm transition hover:text-navy-700", normalizedPath === link.href ? "border-navy-800 font-semibold text-navy-950" : "border-transparent text-slate-600"]}>{link.label}</a>
      ))}
    </nav>
    <a href="/contact#quote" class="focus-ring hidden rounded-full border border-navy-950 bg-navy-950 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-navy-700 hover:bg-navy-700 sm:block">Request a Quote</a>
    <details class="relative md:hidden">
      <summary class="focus-ring cursor-pointer list-none rounded-full border border-navy-950/20 px-4 py-2 text-sm">Menu</summary>
      <nav class="absolute right-0 top-12 w-48 rounded-xl border border-navy-950/10 bg-white p-2 shadow-2xl" aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href} aria-current={normalizedPath === link.href ? 'page' : undefined} class:list={["block border-b-2 px-4 py-3 text-sm text-navy-950 hover:bg-ice-100", normalizedPath === link.href ? "border-navy-800 font-semibold" : "border-transparent"]}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
