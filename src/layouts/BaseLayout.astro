---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
const canonical = new URL(path, Astro.site);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://msprec.com/#organization',
  name: 'Maisi Precision',
  legalName: 'Shaoguan Maisi Precision Technology Co., Ltd.',
  url: 'https://msprec.com/',
  logo: 'https://msprec.com/maisi-logo.png',
  description: 'Maisi Precision is a specialized manufacturer of precision parts and components for mass spectrometry systems and advanced scientific instruments.',
  email: 'engineering@msprec.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shilong Industry Transfer Industrial Park',
    addressLocality: 'Shaoguan',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  knowsAbout: [
    'Mass spectrometry components',
    'Ultra-high vacuum components',
    'Ion optics components',
    'Precision component manufacturing',
    'Scientific instrument components',
  ],
  sameAs: [
    'https://www.facebook.com/msprec',
    'https://x.com/MaisiPrecision',
    'https://www.youtube.com/@MaisiPrecision',
    'https://www.quora.com/profile/Maisi-Precision',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04152f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maisi Precision" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://msprec.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maisi Precision — Mass Spectrometry Precision Components" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://msprec.com/og.png" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
