---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';

const groups = [
  {
    id: '01',
    title: 'Mass Spectrometry Core Components',
    intro: 'Precision components positioned within the ion generation, analysis, collision, and detection pathways of mass spectrometry systems.',
    items: [
      ['Ion source related components', 'Custom parts and structures supporting ion generation assemblies and their critical mechanical interfaces.'],
      ['Filament related components', 'Precision structures associated with filament mounting, positioning, and assembly requirements.'],
      ['Faraday cup assemblies', 'Custom mechanical components and assembly parts for ion detection structures.'],
      ['Quadrupole related precision modules', 'Precision mechanical parts and structures supporting controlled quadrupole alignment and assembly.'],
      ['Collision cell components', 'Application-specific components for collision cell structures and related precision interfaces.'],
    ],
  },
  {
    id: '02',
    title: 'Ultra-high Vacuum Components',
    intro: 'Drawing-based components designed around vacuum integrity, sealing interfaces, material selection, and clean system integration.',
    items: [
      ['Vacuum chambers', 'Customized chamber structures for scientific instrument vacuum environments.'],
      ['Vacuum flanges', 'Precision flange components with controlled sealing and mating features.'],
      ['Sealing structures', 'Mechanical sealing interfaces developed to match system-level vacuum requirements.'],
      ['Vacuum-compatible precision parts', 'Custom geometries and supporting components intended for use in controlled vacuum environments.'],
    ],
  },
  {
    id: '03',
    title: 'Ion Optics & Custom Precision Components',
    intro: 'Specialized, drawing-defined components for ion optics, electrical fields, insulation, shielding, and instrument-specific structures.',
    items: [
      ['Ion optics components', 'Custom structures used to guide, shape, and transmit ions through instrument pathways.'],
      ['Electrodes', 'Precision electrode components including focusing, extraction, and shielding electrode structures.'],
      ['Grids', 'Custom grid structures for electric field control and ion transmission applications.'],
      ['High-purity graphite precision parts', 'Machined graphite parts for application-specific thermal and electrical requirements.'],
      ['Ceramic insulation components', 'Precision ceramic parts supporting electrical isolation and structural integration.'],
    ],
  },
];

const galleryMaterials = [
  { id: 'stainless-steel', label: 'Stainless Steel', altMaterial: 'stainless steel', count: 39 },
  { id: 'copper', label: 'Copper', altMaterial: 'copper', count: 3 },
  { id: 'aluminum', label: 'Aluminum', altMaterial: 'aluminum', count: 5 },
  { id: 'peek', label: 'PEEK', altMaterial: 'PEEK', count: 4 },
  { id: 'ptfe', label: 'PTFE', altMaterial: 'PTFE', count: 3 },
  { id: 'acrylic', label: 'Acrylic', altMaterial: 'acrylic', count: 1 },
];

const galleryImages = galleryMaterials.flatMap((material) =>
  Array.from({ length: material.count }, (_, index) => {
    const filename = `${material.id}-${String(index + 1).padStart(2, '0')}.jpg`;
    return {
      material: material.id,
      thumb: `/images/manufacturing-gallery/thumbs/${filename}`,
      alt: `Custom ${material.altMaterial} precision component manufactured by Maisi Precision.`,
    };
  }),
);
---
<BaseLayout title="Custom Mass Spectrometry Precision Components | Maisi Precision" description="Custom precision components for mass spectrometry, ultra-high vacuum systems and scientific instruments, manufactured from customer drawings by Maisi Precision.">
  <PageHero eyebrow="Product portfolio" title="Mass Spectrometry Precision Parts & Components" intro="Specialized components for ion sources, vacuum systems, ion optics, and scientific instrument assemblies." />
  <section class="border-b hairline bg-white"><div class="container-wide grid gap-8 py-14 md:grid-cols-[1fr_1.4fr] md:py-20"><p class="eyebrow">Specialized component categories</p><p class="lead">We manufacture from customer drawings and technical requirements. Component descriptions are application-focused and do not imply compatibility with any commercial instrument brand or model.</p></div></section>
  {groups.map((group, index) => (
    <section class:list={["py-20 md:py-28", index % 2 ? "bg-ice-50" : "bg-white"]}>
      <div class="container-wide">
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div><span class="text-xs font-bold tracking-[.18em] text-navy-700">{group.id}</span><h2 class="section-title mt-5">{group.title}</h2><p class="mt-6 max-w-xl leading-7 text-slate-600">{group.intro}</p></div>
          <div class="border-t hairline">
            {group.items.map(([title, body], itemIndex) => (
              <article class="group grid gap-3 border-b hairline py-6 sm:grid-cols-[3rem_1fr_1.4fr] sm:gap-5">
                <span class="text-xs font-semibold text-steel-400">{String(itemIndex + 1).padStart(2, '0')}</span><h3 class="font-semibold text-navy-950">{title}</h3><p class="text-sm leading-6 text-slate-600">{body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="bg-ice-50 py-20 md:py-28" aria-labelledby="manufacturing-gallery-heading">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Selected manufacturing work</p>
        <h2 id="manufacturing-gallery-heading" class="section-title mt-5">Manufacturing Gallery</h2>
        <p class="mt-6 text-lg leading-8 text-slate-600">Explore selected custom precision components manufactured for mass spectrometry, vacuum systems and scientific instrumentation. Our manufacturing capabilities cover stainless steel, copper, aluminum, PEEK, PTFE and acrylic, supporting prototypes, small batches and repeat production based on customer drawings.</p>
      </div>

      <div class="mt-9 flex flex-wrap gap-2" role="group" aria-label="Filter gallery by material">
        <button type="button" class="gallery-filter focus-ring" data-gallery-filter="all" aria-pressed="true">All</button>
        {galleryMaterials.map((material) => (
          <button type="button" class="gallery-filter focus-ring" data-gallery-filter={material.id} aria-pressed="false">
            {material.label}
          </button>
        ))}
      </div>

      <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:mt-14 lg:grid-cols-5 lg:gap-5">
        {galleryImages.map((image) => (
          <div
            class="overflow-hidden border hairline bg-white p-2 shadow-[0_10px_28px_rgba(4,21,47,.06)]"
            data-gallery-item
            data-material={image.material}
          >
            <span class="block aspect-square overflow-hidden bg-white">
              <img
                src={image.thumb}
                alt={image.alt}
                width="640"
                height="640"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y hairline bg-white py-12 md:py-16" aria-labelledby="related-insights-heading">
    <div class="container-wide">
      <div class="grid gap-8 md:grid-cols-[.7fr_1.3fr] md:items-start">
        <div>
          <p class="eyebrow">Resources</p>
          <h2 id="related-insights-heading" class="mt-4 text-2xl font-semibold tracking-[-.03em] text-navy-950">Related Technical Insights</h2>
        </div>
        <nav class="border-t hairline" aria-label="Related technical insights">
          <a href="/resources/icp-ms-precision-components/" class="focus-ring group flex items-center justify-between gap-5 border-b hairline py-4 text-sm font-semibold text-navy-950 transition hover:text-navy-700">
            <span>Precision Components for ICP-MS Systems: Manufacturing Requirements and Supplier Considerations</span>
            <span aria-hidden="true" class="text-steel-400 transition group-hover:translate-x-1">→</span>
          </a>
          <a href="/resources/cnc-machining-ion-optics-mass-spectrometry/" class="focus-ring group flex items-center justify-between gap-5 border-b hairline py-4 text-sm font-semibold text-navy-950 transition hover:text-navy-700">
            <span>CNC Machining Ion Optics for Mass Spectrometry Systems</span>
            <span aria-hidden="true" class="text-steel-400 transition group-hover:translate-x-1">→</span>
          </a>
          <a href="/resources/precision-machining-quadrupole-components-mass-spectrometry/" class="focus-ring group flex items-center justify-between gap-5 border-b hairline py-4 text-sm font-semibold text-navy-950 transition hover:text-navy-700">
            <span>Precision Machining Quadrupole Components for Mass Spectrometry</span>
            <span aria-hidden="true" class="text-steel-400 transition group-hover:translate-x-1">→</span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <style>
    .gallery-filter {
      border: 1px solid rgb(148 163 184 / 0.65);
      border-radius: 9999px;
      background: white;
      padding: 0.65rem 1rem;
      color: #0f2747;
      font-size: 0.875rem;
      font-weight: 700;
      line-height: 1;
      transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
    }

    .gallery-filter:hover {
      border-color: #0f2747;
    }

    .gallery-filter[aria-pressed='true'] {
      border-color: #0f2747;
      background: #0f2747;
      color: white;
    }
  </style>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]');
    const galleryItems = document.querySelectorAll<HTMLElement>('[data-gallery-item]');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.galleryFilter;
        if (!filter) return;

        filterButtons.forEach((filterButton) => {
          filterButton.setAttribute('aria-pressed', String(filterButton === button));
        });

        galleryItems.forEach((item) => {
          item.hidden = filter !== 'all' && item.dataset.material !== filter;
        });
      });
    });
  </script>

  <ContactBand />
</BaseLayout>
