---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Resources | Maisi Precision"
  description="Technical guides and insights for mass spectrometry precision components, vacuum assemblies, and instrument manufacturing."
>
  <PageHero
    eyebrow="Technical resources"
    title="Resources"
    intro="Technical guides and insights for mass spectrometry precision components, vacuum assemblies, and instrument manufacturing."
  />

  <section class="bg-white py-16 md:py-22">
    <div class="container-wide space-y-8">
      <article class="card-lift grid overflow-hidden border hairline bg-ice-50 lg:grid-cols-[.42fr_1.58fr]">
        <div class="relative min-h-52 overflow-hidden bg-navy-950 p-8 text-white sm:p-10">
          <div class="grid-bg absolute inset-0 opacity-20"></div>
          <div class="absolute -bottom-24 -right-20 h-64 w-64 rounded-full border border-blue-300/25"></div>
          <div class="relative flex h-full flex-col justify-between gap-14">
            <p class="text-xs font-bold uppercase tracking-[.2em] text-blue-300">Technical guide</p>
            <span class="text-sm font-semibold tracking-[.16em] text-slate-300">CONTENT 001</span>
          </div>
        </div>
        <div class="flex flex-col items-start justify-center p-8 sm:p-10 lg:p-14">
          <h2 class="max-w-3xl text-3xl font-semibold leading-tight tracking-[-.035em] text-navy-950 md:text-4xl">
            How to Choose a Precision Parts Manufacturer for Mass Spectrometry Systems
          </h2>
          <p class="mt-6 max-w-3xl leading-7 text-slate-600">
            A practical guide to evaluating suppliers for mass spectrometry precision components, ion optics, vacuum assemblies, quality control, and module integration.
          </p>
          <a
            href="/resources/how-to-choose-mass-spectrometry-parts-manufacturer"
            class="focus-ring mt-8 inline-flex items-center border-b border-navy-800 pb-1 text-sm font-semibold text-navy-950 transition hover:text-navy-700"
          >
            Read Guide <span class="ml-3" aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="card-lift grid overflow-hidden border hairline bg-ice-50 lg:grid-cols-[.42fr_1.58fr]">
        <div class="relative min-h-52 overflow-hidden bg-navy-950 p-8 text-white sm:p-10">
          <div class="grid-bg absolute inset-0 opacity-20"></div>
          <div class="absolute -bottom-24 -right-20 h-64 w-64 rounded-full border border-blue-300/25"></div>
          <div class="relative flex h-full flex-col justify-between gap-14">
            <p class="text-xs font-bold uppercase tracking-[.2em] text-blue-300">Technical guide</p>
            <span class="text-sm font-semibold tracking-[.16em] text-slate-300">CONTENT 002</span>
          </div>
        </div>
        <div class="flex flex-col items-start justify-center p-8 sm:p-10 lg:p-14">
          <h2 class="max-w-3xl text-3xl font-semibold leading-tight tracking-[-.035em] text-navy-950 md:text-4xl">
            What Makes a Precision Component Suitable for Ultra-High Vacuum (UHV) Applications?
          </h2>
          <p class="mt-6 max-w-3xl leading-7 text-slate-600">
            A technical guide to material selection, dimensional control, surface quality, cleanliness, and vacuum compatibility for UHV components.
          </p>
          <a
            href="/resources/uhv-precision-components"
            class="focus-ring mt-8 inline-flex items-center border-b border-navy-800 pb-1 text-sm font-semibold text-navy-950 transition hover:text-navy-700"
          >
            Read Guide <span class="ml-3" aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
