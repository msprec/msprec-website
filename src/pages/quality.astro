---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';

const pillars = [
  { n: '01', title: 'Deep Mass Spectrometry Experience', body: 'With more than ten years of experience in mass spectrometry component manufacturing, Maisi Precision understands demanding requirements including ultra-high vacuum environments, thermal conditions, precision fitting, and clean component handling.', tags: ['Ultra-high vacuum', 'Thermal requirements', 'Precision fitting', 'Clean manufacturing'] },
  { n: '02', title: 'Flexible R&D Support', body: 'We support scientific research teams and instrument developers with prototype components, small-batch trials, design iterations, and customized manufacturing solutions.', tags: ['Research projects', 'Prototype development', 'Small batches', 'Rapid iteration'] },
  { n: '03', title: 'Integrated Manufacturing Control', body: 'From process planning to final inspection, we coordinate manufacturing steps, quality verification, and supplier processes to maintain stable delivery and consistent component performance.', tags: ['Process control', 'Quality consistency', 'Manufacturing coordination', 'Traceable requirements'] },
  { n: '04', title: 'Technical Support', body: 'We provide drawing review, manufacturing suggestions, inspection reports, and technical communication throughout the project lifecycle.', tags: ['Drawing review', 'Process optimization', 'Inspection reports', 'Technical support'] },
];
---
<BaseLayout title="Quality & Technical Support | Maisi Precision" description="Explore Maisi Precision quality assurance for mass spectrometry components, from drawing review and process control to inspection and technical support.">
  <PageHero eyebrow="Quality approach" title="Understand the function. Control the process." intro="Quality begins with understanding the role of each component in a mass spectrometry system. From vacuum requirements and material selection to precision fitting and inspection, every step is controlled around the instrument application." />
  <section class="bg-white py-20 md:py-28">
    <div class="container-wide grid gap-14 lg:grid-cols-[.62fr_1.38fr]">
      <div class="lg:sticky lg:top-28 lg:self-start"><p class="eyebrow mb-5">Our approach</p><h2 class="section-title">Built around critical requirements.</h2><p class="mt-6 leading-7 text-slate-600">We align manufacturing and inspection to the drawing, material, interfaces, and operating context of each component.</p></div>
      <div class="grid gap-6">
        {pillars.map((pillar) => (
          <article class="card-lift border hairline bg-ice-50 p-7 sm:p-9">
            <div class="grid gap-7 md:grid-cols-[3rem_1fr]"><span class="text-xs font-bold tracking-[.18em] text-navy-700">{pillar.n}</span><div><h3 class="text-2xl font-semibold tracking-[-.025em] text-navy-950">{pillar.title}</h3><p class="mt-5 leading-7 text-slate-600">{pillar.body}</p><div class="mt-7 flex flex-wrap gap-2">{pillar.tags.map((tag) => <span class="rounded-full border hairline bg-white px-3 py-2 text-xs font-medium text-navy-800">{tag}</span>)}</div></div></div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="metal-bg border-y hairline py-20 md:py-28"><div class="container-wide"><div class="max-w-3xl"><p class="eyebrow mb-5">From drawing to verified components</p><h2 class="section-title">From requirements to verification.</h2></div><div class="mt-14 grid border-l border-t hairline sm:grid-cols-2 lg:grid-cols-4">{[['01','Review','Drawings, interfaces, materials, and functional priorities.'],['02','Plan','Manufacturing route, process considerations, and inspection focus.'],['03','Control','Coordinated execution across production and supporting processes.'],['04','Verify','Inspection against agreed drawing and project requirements.']].map(([n,t,b]) => <div class="border-b border-r hairline bg-white/65 p-7"><span class="text-xs font-bold text-navy-700">{n}</span><h3 class="mt-12 text-xl font-semibold text-navy-950">{t}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{b}</p></div>)}</div></div></section>
  <section class="border-b hairline bg-navy-950 py-14 text-white md:py-16">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:items-center">
      <div><h2 class="text-3xl font-semibold tracking-[-.035em] md:text-4xl">Designed Around Mass Spectrometry Challenges</h2><p class="mt-5 max-w-2xl leading-7 text-slate-300">Mass spectrometry components operate under demanding conditions where vacuum performance, thermal stability, material compatibility, precision alignment, and cleanliness directly affect instrument performance.</p></div>
      <div class="grid border-l border-t border-white/15 sm:grid-cols-2">{['Ultra-high vacuum requirements','Thermal stability','Precision alignment','Material compatibility','Clean component handling'].map((focus) => <div class="border-b border-r border-white/15 px-5 py-4 text-sm font-semibold text-blue-100">{focus}</div>)}</div>
    </div>
  </section>
  <section class="bg-white py-20 md:py-28"><div class="container-wide grid gap-12 md:grid-cols-2"><div><p class="eyebrow mb-5">Transparent by principle</p><h2 class="section-title">Claims should be as precise as components.</h2></div><div><p class="lead">We provide project-specific information based on real requirements and available records. Certification status, equipment details, capacity data, and numerical tolerances are shared only when verified and relevant to a customer inquiry.</p><p class="mt-6 text-sm leading-7 text-slate-500">Contact our team to discuss the quality documentation and inspection deliverables required for your project.</p></div></div></section>
  <ContactBand />
</BaseLayout>
